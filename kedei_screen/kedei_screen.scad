total_width = width + wedge_width2 + wall_width2 + nt2
total_height = height + wedge_width2 + wall_width2 + nt2
base_supports = [
    (wall_width + 10, wall_width + 10),
    (wall_width + 10, wall_width + height / 2),
    (wall_width + 10, wall_width + height - 10),
    (wall_width + 50, wall_width + 10),
