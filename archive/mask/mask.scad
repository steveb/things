import solid as s
import solid.utils as u
import math

def render(suffix, final):
    suffix += ".scad"
    s.scad_render_to_file(final, __file__.replace(".py", suffix))

wire_dia = 2.4
wire_rad = wire_dia / 2.0
wire_height = 6.0
cheek_len = 220.0
cheek_height = 7.0
cheek_depth = 4.0

ear_height = 60.0
ear_length = 10.0
ear_depth = 10.0
fabric_height = 160.0
fabric_thick = 0.5
slot_edge = 3.0
slot_height = ear_height - slot_edge - slot_edge
slot = 3.0
wedge = slot - fabric_thick
wedge_height = slot_height - fabric_thick
wedge_stop = 5.0
lug_hole = 5.0

# earpiece
e = s.cube(size=[ear_length, ear_depth, ear_height])

# earpiece slot
e -= u.up(slot_edge)(
    u.forward((ear_depth / 2.0) - (slot / 2.0))(
        s.cube(size=[ear_length, slot, slot_height])
    )
)
# earpiece lugs
lug = s.cylinder(d=ear_depth, h=ear_length, segments=128)
lug -= s.cylinder(d=lug_hole, h=ear_length, segments=128)
lug -= u.back(ear_depth / 2.0)(
    s.cube(size=[ear_length, ear_depth, ear_length])
)
e += u.up(ear_height)(u.forward(ear_depth / 2.0)(
        u.rotate(a=[0,90,0])(lug)
    )
)
e += u.forward(ear_depth / 2.0)(
    u.right(ear_length)(
        u.rotate(a=[0,-90,0])(lug)
    )
)

# wedge
w = s.cube(size=[ear_length, wedge, wedge_height])
w += u.right(ear_length)(
    s.cube(size=[wedge_stop, wedge_stop, wedge_height])
)

# cheek wire surround
c = s.cube(size=[cheek_len, cheek_depth, cheek_height])
c -= u.forward((cheek_depth / 2.0) - (fabric_thick / 2.0))(
    s.cube(size=[cheek_len, fabric_thick, wire_height])
)
c += u.forward(cheek_depth / 2.0)(
    u.up(cheek_height)(
        u.rotate(a=[0,90,0])(
            s.cylinder(d=cheek_depth, h=cheek_len, segments=128)
        )
    )
)
c -= u.forward(cheek_depth / 2.0)(
    u.up(wire_height)(
        u.rotate(a=[0,90,0])(
            s.cylinder(d=wire_dia, h=cheek_len, segments=128)
        )
    )
)

final = u.left(ear_length)(e) + \
    u.left(ear_length + wedge_stop)(u.back(6.0)(w)) + \
    u.left(cheek_depth)(u.back(14.0)(c))

render('', s.rotate(a=[0, 90, 0])(final))
render('ear', s.rotate(a=[0, -90, 0])(e))
render('wedge', u.up(ear_length + wedge_stop)(s.rotate(a=[0, 90, 0])(w)))
render('cheek', s.rotate(a=[0, 0, 30])(c))
